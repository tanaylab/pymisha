#!/usr/bin/env bash
# Pre-push hook. Enable once per clone with:
#   git config core.hooksPath .githooks
#
# Guardrails:
#   - dev → only private (aviezerl/pymisha)
#   - main → only origin (tanaylab/pymisha)
#
# Checks (the lint and type steps CI runs, so they fail here instead of on the PR):
#   - ruff check pymisha/
#   - python -m mypy pymisha/
# They run on each commit being pushed, not on the working tree: pymisha/ and
# pyproject.toml of that commit are exported to a temporary directory, unless the
# commit is HEAD and pymisha/ and pyproject.toml have no local changes, in which case
# they run in place. A missing tool is reported and skipped. SKIP_PREPUSH_CHECKS=1
# skips both checks. CI installs the latest ruff and runs mypy on Python 3.10–3.12,
# so keep local tools current (pip install -U ruff mypy) for the checks to match.
#
set -euo pipefail

REMOTE="$1"
BRANCH="$(git branch --show-current 2>/dev/null || true)"

if [[ "$BRANCH" == "dev" && "$REMOTE" == "origin" ]]; then
    echo "ERROR: Cannot push 'dev' to 'origin' (tanaylab/pymisha)." >&2
    echo "       Use: git push private dev" >&2
    exit 1
fi

if [[ "$BRANCH" == "main" && "$REMOTE" == "private" ]]; then
    echo "ERROR: Cannot push 'main' to 'private' (aviezerl/pymisha)." >&2
    echo "       Use: git push origin main" >&2
    exit 1
fi

if [[ "${SKIP_PREPUSH_CHECKS:-}" == "1" ]]; then
    exit 0
fi

TOP="$(git rev-parse --show-toplevel)"
cd "$TOP"

# The commits being pushed: git passes "<local ref> <local sha> <remote ref> <remote sha>"
# per ref on stdin; a local sha of zeros is a deletion, which has nothing to check.
SHAS=()
while read -r _lref lsha _rref _rsha; do
    [[ -z "${lsha:-}" || "$lsha" =~ ^0+$ ]] && continue
    commit="$(git rev-parse --verify --quiet "${lsha}^{commit}" || true)"
    [[ -z "$commit" ]] && continue
    [[ " ${SHAS[*]-} " == *" $commit "* ]] || SHAS+=("$commit")
done
if [[ ${#SHAS[@]} -eq 0 ]]; then
    exit 0
fi

# Prefer the checkout's own virtualenv, then whatever is on PATH (absolute, since the
# checks may run in a temporary directory).
PY=""
for cand in "$TOP/.venv/bin/python" "${VIRTUAL_ENV:-}/bin/python" python3 python; do
    if [[ -n "$cand" && "$cand" != "/bin/python" ]] && command -v "$cand" >/dev/null 2>&1; then
        PY="$(command -v "$cand")"
        break
    fi
done

RUFF=()
if [[ -x "$TOP/.venv/bin/ruff" ]]; then
    RUFF=("$TOP/.venv/bin/ruff")
elif command -v ruff >/dev/null 2>&1; then
    RUFF=("$(command -v ruff)")
elif [[ -n "$PY" ]] && "$PY" -m ruff --version >/dev/null 2>&1; then
    RUFF=("$PY" -m ruff)
fi
[[ ${#RUFF[@]} -gt 0 ]] || echo "pre-push: ruff not found, skipping (pip install ruff)" >&2

HAVE_MYPY=0
if [[ -n "$PY" ]] && "$PY" -m mypy --version >/dev/null 2>&1; then
    HAVE_MYPY=1
else
    echo "pre-push: mypy not found, skipping (pip install mypy)" >&2
fi

# Runs the checks in directory $1 (holding pymisha/ and pyproject.toml); 1 if any fails.
run_checks() {
    local dir="$1" status=0
    if [[ ${#RUFF[@]} -gt 0 ]]; then
        (cd "$dir" && "${RUFF[@]}" check pymisha/) || status=1
    fi
    if [[ $HAVE_MYPY -eq 1 ]]; then
        (cd "$dir" && "$PY" -m mypy --cache-dir "$TOP/.mypy_cache" pymisha/) || status=1
    fi
    return $status
}

HEAD_SHA="$(git rev-parse HEAD 2>/dev/null || true)"
TMPDIRS=()
cleanup() {
    local d
    for d in "${TMPDIRS[@]-}"; do
        if [[ -n "$d" ]]; then
            rm -rf "$d"
        fi
    done
    return 0
}
trap cleanup EXIT

fail=0
for sha in "${SHAS[@]}"; do
    short="$(git rev-parse --short "$sha")"
    if [[ "$sha" == "$HEAD_SHA" ]] && git diff --quiet HEAD -- pymisha pyproject.toml &&
        [[ -z "$(git ls-files --others --exclude-standard -- pymisha)" ]]; then
        echo "pre-push: ruff and mypy on $short (HEAD, clean)" >&2
        run_checks "$TOP" || fail=1
    else
        dir="$(mktemp -d "${TMPDIR:-/tmp}/pymisha-prepush.XXXXXX")"
        TMPDIRS+=("$dir")
        git archive "$sha" -- pymisha pyproject.toml | tar -x -C "$dir"
        echo "pre-push: ruff and mypy on $short (exported)" >&2
        run_checks "$dir" || fail=1
    fi
done

if [[ $fail -ne 0 ]]; then
    echo "" >&2
    echo "pre-push: fix the errors above, or push with SKIP_PREPUSH_CHECKS=1 to bypass." >&2
    exit 1
fi

exit 0
